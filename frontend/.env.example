# Copy to .env and fill in with `terraform output` values from infra/ (cognito_domain, cognito_app_client_id).
VITE_COGNITO_DOMAIN=https://medbook-<account-id>.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
